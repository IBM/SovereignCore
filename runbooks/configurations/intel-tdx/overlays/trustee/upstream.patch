Target: trustee
Base: trustee-0.10.2.tgz from https://charts.validatedpatterns.io
What: Local GPU verification with RVPS RIM values in the 1.2 RVPS format; GPU policy mounted through
  kbsGpuAttestationPolicyConfigMapName; switchable pull-secret credential policy.
License: Apache-2.0; modified upstream files (see NOTICE).
---
diff --git a/templates/attestation-policy.yaml b/templates/attestation-policy.yaml
index dc0d72a..d66163d 100644
--- a/templates/attestation-policy.yaml
+++ b/templates/attestation-policy.yaml
@@ -365,48 +365,35 @@ data:
         count(container_uids) > 0
     } else := {}
 
-    # GPUs verified by NRAS
-    hardware := 2 if {
-      input["nvidia"]
+    # Local verification checks evidence authenticity; RVPS RIM values supply measurement checks, without device OCSP.
+    gpu := input["nvidia"]
 
-      input["nvidia"]["x-nvidia-gpu-attestation-report-cert-chain"]["x-nvidia-cert-ocsp-status"] == "good"
-      input["nvidia"]["x-nvidia-gpu-attestation-report-cert-chain"]["x-nvidia-cert-status"] == "valid"
+    drv_rim_id := sprintf("NV_GPU_DRIVER_GH100_%s", [gpu.config.driver_version])
 
-      input["nvidia"]["x-nvidia-gpu-attestation-report-cert-chain-fwid-match"]
-      input["nvidia"]["x-nvidia-gpu-attestation-report-parsed"]
-      input["nvidia"]["x-nvidia-gpu-attestation-report-signature-verified"]
+    vbios_rim_id := sprintf("NV_GPU_VBIOS_%s_%s_%s_%s", [
+      gpu.config.project, gpu.config.project_sku, gpu.config.chip_sku,
+      upper(replace(gpu.config.vbios_version, ".", "")),
+    ])
 
-      input["nvidia"]["x-nvidia-gpu-arch-check"]
+    rim_matches(id) if {
+      indices := query_reference_value(sprintf("%s_indices", [id]))
+      count(indices) > 0
+      every i in indices {
+        lower(gpu.measurements[sprintf("%v", [i])]) in query_reference_value(sprintf("%s_m%v", [id, i]))
+      }
     }
 
-    configuration := 2 if {
-      input["nvidia"].secboot
-      input["nvidia"].dbgstat == "disabled"
-      input["nvidia"]["x-nvidia-gpu-vbios-version"] in query_reference_value("allowed_vbios_versions")
-      input["nvidia"]["x-nvidia-gpu-driver-version"] in query_reference_value("allowed_driver_versions")
+    hardware := 2 if {
+      lower(gpu.arch) == "hopper"
     }
 
-    else := 3 if {
-      input["nvidia"].secboot
-      input["nvidia"].dbgstat == "disabled"
+    executables := 2 if {
+      rim_matches(drv_rim_id)
+      rim_matches(vbios_rim_id)
     }
 
-    executables := 3 if {
-      input["nvidia"]["x-nvidia-gpu-vbios-rim-cert-chain"]["x-nvidia-cert-ocsp-status"] == "good"
-      input["nvidia"]["x-nvidia-gpu-vbios-rim-cert-chain"]["x-nvidia-cert-status"] == "valid"
-
-      input["nvidia"]["x-nvidia-gpu-driver-rim-fetched"]
-      input["nvidia"]["x-nvidia-gpu-driver-rim-measurements-available"]
-      input["nvidia"]["x-nvidia-gpu-driver-rim-schema-validated"]
-      input["nvidia"]["x-nvidia-gpu-driver-rim-signature-verified"]
-      input["nvidia"]["x-nvidia-gpu-driver-rim-version-match"]
-
-      input["nvidia"]["x-nvidia-gpu-vbios-rim-fetched"]
-      input["nvidia"]["x-nvidia-gpu-vbios-rim-measurements-available"]
-      input["nvidia"]["x-nvidia-gpu-vbios-rim-schema-validated"]
-      input["nvidia"]["x-nvidia-gpu-vbios-rim-signature-verified"]
-      input["nvidia"]["x-nvidia-gpu-vbios-rim-version-match"]
-
-      input["nvidia"].measres == "success"
+    configuration := 2 if {
+      rim_matches(drv_rim_id)
+      rim_matches(vbios_rim_id)
     }
 {{- end }}
diff --git a/templates/kbs-config-map.yaml b/templates/kbs-config-map.yaml
index 935a464..72551b9 100644
--- a/templates/kbs-config-map.yaml
+++ b/templates/kbs-config-map.yaml
@@ -44,7 +44,8 @@ data:
     {{- if .Values.kbs.gpu.enabled }}
 
     [attestation_service.verifier_config.nvidia_verifier]
-    type = "Remote"
+    # Local: verify GPU evidence in Trustee against RVPS RIM values; Remote (NRAS) needs internet.
+    type = "Local"
     {{- end }}
     {{- if .Values.kbs.tdx.enabled }}
 
diff --git a/templates/kbs.yaml b/templates/kbs.yaml
index 4c19c8c..d8d0169 100644
--- a/templates/kbs.yaml
+++ b/templates/kbs.yaml
@@ -27,6 +27,10 @@ spec:
   kbsHttpsCertSecretName: kbs-https-certificate
   kbsResourcePolicyConfigMapName: resource-policy
   kbsAttestationPolicyConfigMapName: attestation-policy
+  {{- if .Values.kbs.gpu.enabled }}
+  # The operator mounts only default_cpu.rego from the CPU ConfigMap; mount default_gpu.rego too.
+  kbsGpuAttestationPolicyConfigMapName: attestation-policy
+  {{- end }}
   kbsAttestationCertSecretName: attestation-cert
   kbsAttestationKeySecretName: attestation-cert
 
diff --git a/templates/pull-secret-credential-policy.yaml b/templates/pull-secret-credential-policy.yaml
index c456d44..5e45133 100644
--- a/templates/pull-secret-credential-policy.yaml
+++ b/templates/pull-secret-credential-policy.yaml
@@ -1,4 +1,4 @@
-{{- if and (eq .Values.global.coco.secured true) (ne .Values.global.clusterPlatform "Azure") }}
+{{- if and (eq .Values.global.coco.secured true) (ne .Values.global.clusterPlatform "Azure") .Values.kbs.pullSecretCredentialPolicy }}
 {{- /* On Azure peer-pods, CDH does not fetch registry credentials from KBS.
        Pull secrets are distributed to workload namespace SAs instead
        (see sandboxed-policies-chart/pull-secret-distribution.yaml). */ -}}
diff --git a/templates/rvps-values-policies.yaml b/templates/rvps-values-policies.yaml
index e5a1016..f5504d7 100644
--- a/templates/rvps-values-policies.yaml
+++ b/templates/rvps-values-policies.yaml
@@ -108,6 +108,15 @@ spec:
           {{`{{- $referenceValues = set $referenceValues "xfam" (toJson $e | base64enc | replace "+" "-" | replace "/" "_") -}}`}}
           {{`{{- end -}}`}}
           {{`{{- end -}}`}}
+{{- if .Values.kbs.gpu.enabled }}
+          {{`{{- $gpuStash := (lookup "v1" "Secret" "trustee-operator-system" "gpu-reference-values") -}}`}}
+          {{`{{- if $gpuStash -}}`}}
+          {{`{{- range $name, $vals := $gpuStash.data -}}`}}
+          {{`{{- $e := dict "version" "0.1.0" "name" $name "expiration" "2027-12-12T00:00:00Z" "value" ($vals | base64dec | fromJson) -}}`}}
+          {{`{{- $referenceValues = set $referenceValues $name (toJson $e | base64enc | replace "+" "-" | replace "/" "_") -}}`}}
+          {{`{{- end -}}`}}
+          {{`{{- end -}}`}}
+{{- end }}
           {{- if .Values.kbs.azure }}
           {{- with .Values.kbs.azure }}
           {{`{{- $e := dict "version" "0.1.0" "name" "measurement" "expiration" "2099-12-31T00:00:00Z" "value" (list `}} "{{ .snpLaunchMeasurement }}" {{`) -}}`}}
