# shellcheck shell=bash
# Copy this directory to deploy/env/<site>; see deploy/env/README.md for the key reference.

CHART_REGISTRY="${CHART_REGISTRY:-registry-quay-quay-enterprise.apps.mgmt.example.com}"
OCI_ORG="${OCI_ORG:-sovcloud/coco}"
MIRROR_REGISTRY="${MIRROR_REGISTRY:-mirror.example.com:8443}"
HUB_DOMAIN="${HUB_DOMAIN:-mgmt.example.com}"
MIRROR_HOME="${MIRROR_HOME:-${HOME}/mirror}"
HUB_KUBECONFIG="${HUB_KUBECONFIG:-${HOME}/mirror/ocp-cluster/auth/kubeconfig}"
TENANT_KUBECONFIG="${TENANT_KUBECONFIG:-${HOME}/tenant-kubeconfig.yaml}"
TENANT_CLUSTER="${TENANT_CLUSTER:-tenant-cluster}"
# CUGA agent namespace (tenant-<tenant id>); empty: the tenant is deployed without the agent.
TENANT_AGENT_NAMESPACE="${TENANT_AGENT_NAMESPACE:-}"
# Expected API URLs must match kubeconfig server values (trailing slash ignored).
EXPECT_HUB_API_SERVER="${EXPECT_HUB_API_SERVER:-https://api.mgmt.example.com:6443}"
EXPECT_TENANT_API_SERVER="${EXPECT_TENANT_API_SERVER:-https://api.tenant-cluster.example.com:6443}"
# Use trusted CA bundles; *_TLS_INSECURE=true explicitly disables verification.
HUB_INGRESS_CA_FILE="${HUB_INGRESS_CA_FILE:-${HOME}/.coco-pattern/mirror-ca.pem}"
MIRROR_CA_FILE="${MIRROR_CA_FILE:-${HOME}/.coco-pattern/mirror-ca.pem}"
# TDX_REGISTRY_AUTH_FILE must hold dedicated read-only credentials, never the Quay admin.
TDX_REGISTRY_AUTH_FILE="${TDX_REGISTRY_AUTH_FILE:-${HOME}/.coco-pattern/tdx-registry-auth.json}"
