# ──────────────────────────────────────────────────────────────────────────────
# Sovereign Core — Metrics Aggregator Notebooks
# Copy this file to .env and fill in your values.
#
# Required for Fetch - Usage Data.ipynb (live deployment):
#   APP_DOMAIN, SERVICE_ID, TENANT_ID, IAM_ACCOUNT_TYPE, API_KEY
#
# Required for Use Case - Cross-Service Analysis.ipynb:
#   SERVICE_ID_A, SERVICE_ID_B  (set to the two services you want to compare)
#
# Required for Processing & Use Case notebooks (optional overrides):
#   RAW_DATA_PATH, AGGREGATED_DATA_PATH, GROUPED_DATA_PATH
#   If left blank, paths are derived from APP_DOMAIN and SERVICE_ID here.
# ──────────────────────────────────────────────────────────────────────────────

APP_DOMAIN=apps.cluster.url.com

# Primary service — used by Fetch and all single-service Processing/Use Case notebooks
SERVICE_ID=servicebrokercore
TENANT_ID=platform

# Cross-service analysis — used by Use Case - Cross-Service Analysis.ipynb
# Set both to the two catalog service IDs you want to compare.
# Default values below point at the included cross-service sample data.
SERVICE_ID_A=cluster-as-a-service
SERVICE_ID_B=servicebrokercore

# IAM account type to use for token exchange.
# Options:
#   platform         → MSP / Billing Manager
#   <tenant-uuid>    → Application Developer (replace with actual tenant UUID)
#   global_account   → Internal Control Plane Service
IAM_ACCOUNT_TYPE=platform

# API key for the chosen IAM_ACCOUNT_TYPE — never commit a real value here
API_KEY=your-api-key-here

# Data paths for visualization notebooks (optional)
# If not set, paths are derived as data/<APP_DOMAIN>/<SERVICE_ID>/<type>/
# Override to point at a different service's data or a custom directory.
# Examples:
#   RAW_DATA_PATH=data/apps.my-cluster.cp.fyre.ibm.com/my-service/raw
#   RAW_DATA_PATH=data/sovereigncore_native_data/raw
#   RAW_DATA_PATH=/path/to/custom/data/raw
RAW_DATA_PATH=
AGGREGATED_DATA_PATH=
GROUPED_DATA_PATH=
